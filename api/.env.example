# =============================================================================
# BACKEND (endpoint serverless /api/askIAViva) — variáveis de ambiente.
# -----------------------------------------------------------------------------
# COMO USAR:
#  • Local: copie para `api/.env` (git-ignorado) e preencha GROQ_API_KEY.
#  • Vercel: defina estas variáveis em Project Settings → Environment Variables.
#            NUNCA coloque a chave no código nem no frontend.
# =============================================================================

# SEGREDO — chave do Groq (só no backend!). Em produção, defina no painel do Vercel.
GROQ_API_KEY=

# Provedor e modelo de IA
AI_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b

# Proteção anti-abuso (a IA é aberta, sem login)
RL_PER_IP=8                       # máx. de perguntas por IP por minuto
DAILY_GLOBAL_LIMIT=2000           # teto total de perguntas por dia
ALLOWED_ORIGINS=https://viva-inteligente.vercel.app   # origens que podem chamar a IA
