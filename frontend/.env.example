# =============================================================================
# Configuração do FRONTEND (Vite) — COPIE para .env.local e preencha.
# -----------------------------------------------------------------------------
# Estes valores são a configuração PÚBLICA do Firebase (não são segredos: eles
# apenas identificam o projeto no navegador). Pegue no Console do Firebase em:
#   Configurações do projeto → Seus apps → App da Web → SDK/Config.
# NÃO coloque aqui nenhuma chave de servidor (Groq / Mercado Pago).
# =============================================================================

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=SEU_PROJECT_ID.firebaseapp.com
VITE_FB_PROJECT_ID=SEU_PROJECT_ID
VITE_FB_APP_ID=
VITE_FB_FUNCTIONS_REGION=southamerica-east1
