rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do usuário: cada um lê/escreve o próprio documento.
    // Campos sensíveis (premium, papel de admin) NÃO podem ser alterados pelo
    // cliente — só pelo backend (Cloud Functions / Admin SDK, que ignora rules).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !("premium" in request.resource.data)
                    && !("role" in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(["premium", "role"]) == false;

      // Uso da IA por dia: somente leitura pelo dono; escrita só via backend.
      match /aiUsage/{day} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Logs de IA e custos: somente backend (nunca acessível pelo cliente).
    match /aiLogs/{doc} {
      allow read, write: if false;
    }

    // Indicações: leitura pelo indicador; escrita só via backend.
    match /referrals/{id} {
      allow read: if request.auth != null && resource.data.referrerUid == request.auth.uid;
      allow write: if false;
    }
  }
}
